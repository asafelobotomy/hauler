<!-- AppStream metadata: what software centres (GNOME Software, Discover, bindaru) show for the app. -->
<component type="desktop-application">
  <id>io.github.asafelobotomy.hauler</id>
  <name>Hauler</name>
  <summary>Fast, resumable downloads over parallel connections</summary>
  <description>
    <p>Hauler downloads files over several connections at once and picks up where it left off after a dropped connection, a crash or a reboot.</p>
    <p>A small background service does the work, so downloads carry on with the window closed. On the uQ desktop they also show in a bar widget and in Settings.</p>
  </description>
  <launchable type="desktop-id">hauler.desktop</launchable>
  <icon type="stock">folder-download</icon>
  <url type="homepage">https://github.com/asafelobotomy/hauler</url>
  <url type="bugtracker">https://github.com/asafelobotomy/hauler/issues</url>
  <developer id="io.github.asafelobotomy">
    <name>asafelobotomy</name>
  </developer>
  <categories>
    <category>Network</category>
    <category>FileTransfer</category>
  </categories>
  <keywords>
    <keyword>download</keyword>
    <keyword>manager</keyword>
    <keyword>resume</keyword>
    <keyword>http</keyword>
  </keywords>
